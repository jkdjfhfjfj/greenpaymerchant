# Greenpay / Payrail environment template.
# Empty values are intentional: set credentials in Replit Secrets or your
# deployment's secret store. Never copy secret values into this file.

# Database
DATABASE_SOURCE=replit
DATABASE_URL=
EXTERNAL_DATABASE_URL=
PGHOST=
PGPORT=
PGUSER=
PGPASSWORD=
PGDATABASE=

# Clerk authentication
CLERK_PROVIDER_MODE=managed
VITE_CLERK_PROVIDER_MODE=managed
CLERK_SECRET_KEY=
CLERK_PUBLISHABLE_KEY=
VITE_CLERK_PUBLISHABLE_KEY=
EXTERNAL_CLERK_SECRET_KEY=
VITE_EXTERNAL_CLERK_PUBLISHABLE_KEY=
LEGACY_CLERK_SECRET_KEY=
VITE_CLERK_PROXY_URL=

# Application security and access
SESSION_SECRET=
CREDENTIALS_ENCRYPTION_KEY=
ADMIN_EMAILS=
CORS_ALLOWED_ORIGINS=
GREENPAY_WEBHOOK_SECRET=

# Public URLs and email sender
PUBLIC_APP_URL=
PUBLIC_SITE_URL=
VITE_PUBLIC_SITE_URL=
FROM_EMAIL=
MAILTRAP_API_TOKEN=
MAILTRAP_API_KEY=

# Optional payment, identity, FX, and media provider environment fallbacks.
# These credentials can also be configured in the Admin → Credentials vault.
PAYSTACK_SECRET_KEY=
PAYHERO_BASIC_AUTH=
PAYHERO_AUTH_TOKEN=
PAYHERO_CHANNEL_ID=
PAYZAAPI_API_KEY=
PAYZAAPI_PUBLIC_KEY=
PAYZAAPI_SECRET_KEY=
PAYZAAPI_WEBHOOK_SECRET=
PAYZA_PUBLIC_KEY=
PAYZA_SECRET_KEY=
PAYZA_WEBHOOK_SECRET=
DIDIT_API_KEY=
DIDIT_WEBHOOK_SECRET=
DIDIT_WORKFLOW_ID=
DIDIT_KYB_WORKFLOW_ID=
CURRENCYAPI_API_KEY=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Runtime/build values. Replit workflows provide PORT and BASE_PATH.
NODE_ENV=development
LOG_LEVEL=
PORT=
BASE_PATH=
REPL_ID=
REPLIT_DOMAINS=
REPLIT_DEV_DOMAIN=
REPLIT_ENVIRONMENT=
REPLIT_CLUSTER=

# Test-only API smoke check
PAYRAIL_SMOKE_API_URL=